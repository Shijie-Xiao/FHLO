data/ibtracs/**/fast_reference*
# ensemble outputs (dataset.pkl / chi_s.nc / ode.nc trees)
ensemble_data/
ensemble/out/
# GEFS cfgrib->NetCDF cache
data/gefs_nc_cache/

# ---- Static precomputed fields (tracked on purpose: small, slow to rebuild) ----
# precalc_data/

# ---- Logs & scratch ----
logs/
*.log
download/*.log

# ---- Download scripts (one-off crop/download utilities; not part of the model) ----
download/

